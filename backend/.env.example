# Copy to backend/.env and fill in. `.env` is git-ignored — never commit real values.
#
#   cp .env.example .env
#   openssl rand -hex 64                        # paste into DEVISE_JWT_SECRET_KEY
#
# No secret in this project has a default: if a required variable is missing the
# process refuses to boot.

# --- Database ---------------------------------------------------------------
# Defaults match the `postgres` service in docker-compose.dev.yml at the
# repository root.
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_USERNAME=marmitas
DATABASE_PASSWORD=marmitas
DATABASE_NAME=marmitas_top_development
TEST_DATABASE_NAME=marmitas_top_test

# --- Authentication ---------------------------------------------------------
# REQUIRED. Signing key for the JWTs issued by devise-jwt. Generate with
# `openssl rand -hex 64`. Without it the application raises on boot.
DEVISE_JWT_SECRET_KEY=

# --- Push notifications -----------------------------------------------------
# Firebase Cloud Messaging server key. Optional in development: when it is empty
# PushNotificationService does not send anything.
FCM_SERVER_KEY=

# --- Server -----------------------------------------------------------------
PORT=3000
RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=2
# PIDFILE=tmp/pids/server.pid
# Run Solid Queue inside the Puma process instead of a separate worker.
# SOLID_QUEUE_IN_PUMA=

# --- Production only --------------------------------------------------------
# Not needed for local development; listed so the full set is in one place.
# SECRET_KEY_BASE=
# RAILS_LOG_LEVEL=info
# BACKEND_DATABASE_PASSWORD=
# REDIS_URL=redis://localhost:6379/1
